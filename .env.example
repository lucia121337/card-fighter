# card-fighter 환경변수 예시
# 이 파일을 복사해 `.env` 로 저장하고 값을 채운다.  (.env 자체는 git 커밋 금지 — .gitignore 처리됨)
#
# 이 키들은 '실시간 검색어 / 트렌드분석'(api/naver-trends.js) 기능에만 필요하다.
# 정적 화면(카드 목록·캐시백·필터·상세)은 이 키 없이 `python serve.py` 만으로 다 보인다.
# 실제 값은 팀 채팅이나 Vercel 프로젝트 환경변수에서 받는다.

# 네이버 검색 트렌드 오픈API  (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Upstash Redis (REST) — 트렌드 결과 캐시 저장용  (https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
